# TrustLayer environment configuration
# Copy this file to ".env" (or set these as real environment variables).

# demo  = heuristics + fixed fusion (no training needed)
# model = load trained artifacts from models/ if present, else fall back
MODE=demo

# Common representation dimension (128 or 256)
EMBEDDING_DIM=128

# Reproducibility seed for all deterministic projections
RANDOM_SEED=1337

# Maximum upload size in bytes (default 200 MB)
MAX_UPLOAD_BYTES=209715200

# Video frame sampling range
VIDEO_MIN_FRAMES=10
VIDEO_MAX_FRAMES=20

# Heuristic decision thresholds (NOT calibrated probabilities)
SUSPICIOUS_THRESHOLD=0.60
AUTHENTIC_THRESHOLD=0.35
